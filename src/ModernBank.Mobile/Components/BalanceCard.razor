@implements IDisposable

<section class="@ContainerClass" aria-labelledby="@HeadingId">
    <div class="flex items-start justify-between gap-4">
        <div>
            <p class="text-sm font-medium @LabelClass">@Label</p>
            <h2 id="@HeadingId" class="mt-2 font-display text-3xl font-semibold tracking-[-0.045em] sm:text-4xl" aria-live="polite">@DisplayedAmount</h2>
        </div>
        @if (ShowVisibilityToggle)
        {
            <button class="grid size-11 shrink-0 place-items-center rounded-full border border-white/25 bg-white/10 text-white transition-colors hover:bg-white/20 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-white" type="button" aria-label="@(Banking.IsBalanceVisible ? "Hide all balances" : "Show all balances")" aria-pressed="@Banking.IsBalanceVisible" @onclick="ToggleVisibility">
                <AppIcon Name="@(Banking.IsBalanceVisible ? "eye" : "eye-off")" Class="size-5" />
            </button>
        }
        else
        {
            <span class="@BadgeClass"><AppIcon Name="@BadgeIcon" Class="size-4" />@BadgeText</span>
        }
    </div>
    <p class="mt-3 max-w-sm text-sm leading-5 @CopyClass">@Description</p>
    @if (Footer is not null)
    {
        <div class="mt-5 border-t @FooterBorderClass pt-4">@Footer</div>
    }
</section>

@code {
    [Parameter, EditorRequired] public string Label { get; set; } = string.Empty;
    [Parameter, EditorRequired] public decimal Amount { get; set; }
    [Parameter, EditorRequired] public string Description { get; set; } = string.Empty;
    [Parameter, EditorRequired] public string Variant { get; set; } = "available";
    [Parameter] public string HeadingId { get; set; } = $"balance-{Guid.NewGuid():N}";
    [Parameter] public bool ShowVisibilityToggle { get; set; }
    [Parameter] public string BadgeText { get; set; } = "Available";
    [Parameter] public string BadgeIcon { get; set; } = "check";
    [Parameter] public RenderFragment? Footer { get; set; }
    [Inject] private DemoBankingState Banking { get; set; } = default!;

    private bool IsTax => Variant == "tax";
    private string ContainerClass => IsTax
        ? "balance-card balance-card-tax"
        : "balance-card balance-card-available";
    private string LabelClass => IsTax ? "text-amber-950" : "text-blue-50";
    private string CopyClass => IsTax ? "text-amber-950" : "text-blue-50";
    private string FooterBorderClass => IsTax ? "border-amber-900/15" : "border-white/20";
    private string BadgeClass => IsTax
        ? "inline-flex min-h-9 items-center gap-1.5 rounded-full border border-amber-800/20 bg-white/70 px-3 text-xs font-semibold text-amber-950"
        : "inline-flex min-h-9 items-center gap-1.5 rounded-full border border-white/20 bg-white/10 px-3 text-xs font-semibold text-white";
    private string DisplayedAmount => Banking.IsBalanceVisible ? DemoBankingState.Money(Amount) : "R •••••••";

    protected override void OnInitialized()
    {
        Banking.Changed += OnBankingChanged;
    }

    private void ToggleVisibility()
    {
        Banking.IsBalanceVisible = !Banking.IsBalanceVisible;
        Banking.ClearNotice();
    }

    private void OnBankingChanged() => _ = InvokeAsync(StateHasChanged);

    public void Dispose()
    {
        Banking.Changed -= OnBankingChanged;
    }
}
