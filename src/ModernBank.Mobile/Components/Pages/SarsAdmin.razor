@page "/sars-admin"
@inject DemoBankingState Banking
@inject NavigationManager Navigation

<PageTitle>SARS review preview · Modern Bank</PageTitle>

<div class="mx-auto max-w-6xl px-4 py-6 sm:px-7 lg:px-10 lg:py-9">
    @if (!Banking.IsSarsAdmin)
    {
        <section class="rounded-2xl border border-stroke bg-white p-6">
            <h1 class="font-display text-xl font-semibold">This preview is role-gated</h1>
            <p class="mt-2 leading-6 text-secondary">Sign in using the SARS administrator preview option to view sample refund requests.</p>
            <a class="primary-button mt-4 inline-flex" href="/login">Go to sign in</a>
        </section>
    }
    else
    {
        <header class="mb-6 flex items-start justify-between gap-4">
            <div>
                <p class="inline-flex items-center gap-2 rounded-full border border-stroke bg-white px-3 py-1.5 text-sm font-medium text-secondary"><AppIcon Name="government" Class="size-4 text-brand" />Restricted demo role</p>
                <h1 class="mt-3 font-display text-2xl font-semibold tracking-tight sm:text-3xl">SARS refund review</h1>
                <p class="mt-2 max-w-2xl leading-6 text-secondary">Review fictional requests and mark a sample as authorized. This view has no connection to SARS, taxpayer records or payment systems.</p>
            </div>
            <button class="secondary-button shrink-0" type="button" @onclick="SignOut">Sign out</button>
        </header>

        <section class="grid gap-3 sm:grid-cols-2" aria-label="Sample SARS activity totals">
            <article class="rounded-2xl border border-stroke bg-white p-4">
                <p class="text-sm text-secondary">Sample payments received</p>
                <p class="mt-2 font-display text-2xl font-semibold">@Banking.SarsPayments.Count</p>
            </article>
            <article class="rounded-2xl border border-stroke bg-white p-4">
                <p class="text-sm text-secondary">Recorded amount</p>
                <p class="mt-2 font-display text-2xl font-semibold">@DemoBankingState.Money(Banking.SarsPayments.Sum(payment => payment.Amount))</p>
            </article>
            <article class="rounded-2xl border border-stroke bg-white p-4">
                <p class="text-sm text-secondary">Refund requests</p>
                <p class="mt-2 font-display text-2xl font-semibold">@Banking.RefundRequests.Count</p>
            </article>
            <article class="rounded-2xl border border-stroke bg-white p-4">
                <p class="text-sm text-secondary">Awaiting review</p>
                <p class="mt-2 font-display text-2xl font-semibold">@Banking.RefundRequests.Count(request => !request.IsAuthorized)</p>
            </article>
        </section>

        <section class="mt-5 rounded-2xl border border-stroke bg-white p-5 sm:p-6" aria-labelledby="received-payments-heading">
            <div class="mb-4">
                <h2 id="received-payments-heading" class="font-display text-lg font-semibold">Payments received</h2>
                <p class="mt-1 text-sm text-secondary">Fictional SARS payment records for individual, company and organization accounts.</p>
            </div>
            @if (Banking.SarsPayments.Count == 0)
            {
                <div class="rounded-xl bg-canvas px-4 py-8 text-center">
                    <p class="font-semibold">No sample payments</p>
                    <p class="mt-1 text-sm text-secondary">Sample payment records will appear here when available.</p>
                </div>
            }
            else
            {
                <ul class="space-y-3 md:hidden">
                    @foreach (var payment in Banking.SarsPayments.OrderByDescending(item => item.Received))
                    {
                        <li class="rounded-xl border border-stroke p-4">
                            <div class="flex items-start justify-between gap-3">
                                <span>
                                    <span class="block font-semibold">@payment.Taxpayer</span>
                                    <span class="mt-1 block text-sm text-secondary">@payment.AccountType · Ref @payment.TaxReference</span>
                                </span>
                                <strong class="shrink-0">@DemoBankingState.Money(payment.Amount)</strong>
                            </div>
                            <p class="mt-3 text-xs text-secondary">@payment.PaymentReference · @payment.Received.ToString("d MMM yyyy")</p>
                        </li>
                    }
                </ul>
                <div class="hidden overflow-x-auto md:block">
                    <table class="w-full min-w-[700px] text-left text-sm">
                        <thead>
                            <tr class="border-b border-stroke text-secondary">
                                <th class="px-3 py-3 font-semibold" scope="col">Taxpayer</th>
                                <th class="px-3 py-3 font-semibold" scope="col">Tax reference</th>
                                <th class="px-3 py-3 font-semibold" scope="col">Payment reference</th>
                                <th class="px-3 py-3 font-semibold" scope="col">Received</th>
                                <th class="px-3 py-3 text-right font-semibold" scope="col">Amount</th>
                            </tr>
                        </thead>
                        <tbody class="divide-y divide-stroke">
                            @foreach (var payment in Banking.SarsPayments.OrderByDescending(item => item.Received))
                            {
                                <tr>
                                    <td class="px-3 py-4">
                                        <span class="block font-semibold">@payment.Taxpayer</span>
                                        <span class="mt-0.5 block text-xs text-secondary">@payment.AccountType</span>
                                    </td>
                                    <td class="px-3 py-4">@payment.TaxReference</td>
                                    <td class="px-3 py-4">@payment.PaymentReference</td>
                                    <td class="px-3 py-4">@payment.Received.ToString("d MMM yyyy")</td>
                                    <td class="px-3 py-4 text-right font-semibold">@DemoBankingState.Money(payment.Amount)</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </section>

        <section class="mt-5 rounded-2xl border border-stroke bg-white p-5 sm:p-6" aria-labelledby="refund-requests-heading">
            <div class="mb-4">
                <h2 id="refund-requests-heading" class="font-display text-lg font-semibold">Refund requests</h2>
                <p class="mt-1 text-sm text-secondary">Fictional taxpayer details for interface preview only.</p>
            </div>
            @if (Banking.RefundRequests.Count == 0)
            {
                <div class="rounded-xl bg-canvas px-4 py-8 text-center">
                    <p class="font-semibold">No sample requests to review</p>
                    <p class="mt-1 text-sm text-secondary">New demo requests will appear here when available.</p>
                </div>
            }
            else
            {
                <div class="space-y-3 md:hidden">
                    @foreach (var request in Banking.RefundRequests)
                    {
                        <article class="rounded-xl border border-stroke p-4">
                            <div class="flex items-start justify-between gap-3">
                                <div>
                                    <h3 class="font-semibold">@request.Taxpayer</h3>
                                    <p class="mt-1 text-sm text-secondary">@request.AccountType · @request.Reference</p>
                                </div>
                                <span class="@StatusClass(request)">@StatusText(request)</span>
                            </div>
                            <p class="mt-3 text-sm text-secondary">Submitted @request.Submitted.ToString("d MMM yyyy")</p>
                            <p class="mt-1 font-display text-lg font-semibold">@DemoBankingState.Money(request.Amount)</p>
                            @if (request.IsAuthorized)
                            {
                                <span class="mt-4 inline-flex min-h-11 w-full items-center justify-center rounded-xl bg-mint px-4 text-sm font-semibold text-positive">Already authorized</span>
                            }
                            else
                            {
                                <a class="primary-button mt-4 w-full" href="@($"/sars-admin/review/{request.Id}")">Review request</a>
                            }
                        </article>
                    }
                </div>
                <div class="hidden overflow-x-auto md:block">
                    <table class="w-full min-w-[700px] text-left text-sm">
                        <thead>
                            <tr class="border-b border-stroke text-secondary">
                                <th class="px-3 py-3 font-semibold" scope="col">Taxpayer</th>
                                <th class="px-3 py-3 font-semibold" scope="col">Reference</th>
                                <th class="px-3 py-3 font-semibold" scope="col">Submitted</th>
                                <th class="px-3 py-3 text-right font-semibold" scope="col">Amount</th>
                                <th class="px-3 py-3 font-semibold" scope="col">Status</th>
                                <th class="px-3 py-3 text-right font-semibold" scope="col">Action</th>
                            </tr>
                        </thead>
                        <tbody class="divide-y divide-stroke">
                            @foreach (var request in Banking.RefundRequests)
                            {
                                <tr>
                                    <td class="px-3 py-4">
                                        <span class="block font-semibold">@request.Taxpayer</span>
                                        <span class="mt-0.5 block text-xs text-secondary">@request.AccountType</span>
                                    </td>
                                    <td class="px-3 py-4">@request.Reference</td>
                                    <td class="px-3 py-4">@request.Submitted.ToString("d MMM yyyy")</td>
                                    <td class="px-3 py-4 text-right font-semibold">@DemoBankingState.Money(request.Amount)</td>
                                    <td class="px-3 py-4"><span class="@StatusClass(request)">@StatusText(request)</span></td>
                                    <td class="px-3 py-4 text-right">
                                        @if (request.IsAuthorized)
                                        {
                                            <span class="font-semibold text-positive">Authorized</span>
                                        }
                                        else
                                        {
                                            <a class="inline-flex min-h-11 items-center rounded-xl px-3 font-semibold text-brand hover:bg-wash" href="@($"/sars-admin/review/{request.Id}")">Review</a>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </section>
        <p class="mt-5 rounded-xl border border-amber-200 bg-amber-50 px-4 py-3 text-sm leading-5 text-amber-950">Role restriction is a local UI demonstration, not production access control. No taxpayer data or actual refund processing is involved.</p>
    }
</div>

@code {
    private static string StatusText(SarsRefundRequest request) => request.IsAuthorized ? "Authorized (demo)" : "Awaiting review";
    private static string StatusClass(SarsRefundRequest request) => request.IsAuthorized
        ? "inline-flex min-h-7 items-center rounded-full bg-mint px-2.5 text-xs font-semibold text-positive"
        : "inline-flex min-h-7 items-center rounded-full bg-amber-50 px-2.5 text-xs font-semibold text-amber-950";

    private void SignOut()
    {
        Banking.SignOut();
        Navigation.NavigateTo("/login", replace: true);
    }
}
