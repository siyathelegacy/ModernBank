@page "/tax/pay"
@inject DemoBankingState Banking
@inject NavigationManager Navigation

<PageTitle>Confirm SARS payment · Modern Bank</PageTitle>

<div class="mx-auto max-w-2xl px-4 py-6 sm:px-7 lg:px-10 lg:py-9">
    <a class="inline-flex min-h-11 items-center gap-2 rounded-xl px-2 text-sm font-semibold text-brand hover:bg-wash" href="/tax"><AppIcon Name="chevron-right" Class="size-4 rotate-180" />Back to tax centre</a>

    @if (Banking.IsSarsAdmin)
    {
        <section class="mt-4 rounded-2xl border border-stroke bg-white p-6">
            <h1 class="font-display text-xl font-semibold">Taxpayer payment unavailable</h1>
            <p class="mt-2 leading-6 text-secondary">The SARS administrator preview cannot use taxpayer actions.</p>
        </section>
    }
    else if (string.IsNullOrWhiteSpace(Banking.TaxReference))
    {
        <section class="mt-4 rounded-2xl border border-stroke bg-white p-6">
            <h1 class="font-display text-xl font-semibold">Add your tax reference first</h1>
            <p class="mt-2 leading-6 text-secondary">A tax reference is needed to continue this simulated payment flow.</p>
            <a class="primary-button mt-5 inline-flex" href="/profile">Add tax reference</a>
        </section>
    }
    else if (Banking.SarsBalance <= 0)
    {
        <section class="mt-4 rounded-2xl border border-stroke bg-white p-6">
            <h1 class="font-display text-xl font-semibold">No frozen balance available</h1>
            <p class="mt-2 leading-6 text-secondary">There is no money in the demo SARS reserve to record as a payment.</p>
        </section>
    }
    else
    {
        <section class="mt-4 rounded-2xl border border-stroke bg-white p-5 sm:p-8" aria-labelledby="payment-heading">
            <span class="inline-flex items-center gap-2 rounded-full bg-amber-50 px-3 py-1.5 text-sm font-semibold text-amber-950"><AppIcon Name="lock" Class="size-4" />Frozen SARS balance</span>
            <h1 id="payment-heading" class="mt-4 font-display text-2xl font-semibold tracking-tight">Confirm simulated payment</h1>
            <p class="mt-2 max-w-lg leading-6 text-secondary">This separate confirmation step makes clear what will happen. The action records a local demo entry only; it will not send money to SARS or reduce a real account balance.</p>
            <p class="mt-5 rounded-xl bg-canvas px-4 py-3 text-sm">Available in frozen reserve: <strong>@VisibleMoney(Banking.SarsBalance)</strong></p>
            <EditForm Model="@Form" OnValidSubmit="ConfirmSarsPayment" class="mt-5 space-y-5">
                <DataAnnotationsValidator />
                <ValidationSummary class="rounded-xl border border-danger/20 bg-danger-wash px-4 py-3 text-sm text-danger" role="alert" />
                <div class="form-field">
                    <label class="field-label" for="payment-amount">Amount to record</label>
                    <InputNumber id="payment-amount" @bind-Value="Form.Amount" class="field-control" min="1" max="@Banking.SarsBalance" step="0.01" inputmode="decimal" />
                    <ValidationMessage For="() => Form.Amount" class="field-error" />
                    <p class="field-hint">The amount cannot exceed the frozen SARS balance.</p>
                </div>
                <label class="flex min-h-11 items-start gap-3 rounded-xl px-1 py-2 text-sm leading-5 text-secondary">
                    <InputCheckbox @bind-Value="Form.ConfirmPayment" class="mt-1 size-4 rounded border-stroke text-brand focus:ring-brand" />
                    <span>I understand this will add a simulated SARS payment to the demo history.</span>
                </label>
                <ValidationMessage For="() => Form.ConfirmPayment" class="field-error" />
                @if (PaymentError is not null)
                {
                    <p class="rounded-xl border border-danger/20 bg-danger-wash px-4 py-3 text-sm text-danger" role="alert">@PaymentError</p>
                }
                <div class="flex flex-col-reverse gap-2 sm:flex-row sm:justify-end">
                    <a class="secondary-button" href="/tax">Keep funds frozen</a>
                    <button class="primary-button" type="submit">Confirm demo payment</button>
                </div>
            </EditForm>
        </section>
    }
    <p class="mt-5 rounded-xl border border-amber-200 bg-amber-50 px-4 py-3 text-sm leading-5 text-amber-950">This is not a SARS payment service. No money is transferred and the demo record has no legal effect.</p>
</div>

@code {
    private readonly TaxPaymentForm Form = new();
    private string? PaymentError { get; set; }

    protected override void OnInitialized()
    {
        Form.Amount = Banking.SarsBalance;
    }

    private string VisibleMoney(decimal amount) => Banking.IsBalanceVisible ? DemoBankingState.Money(amount) : "R •••••••";

    private void ConfirmSarsPayment()
    {
        PaymentError = null;
        if (Form.Amount is not { } amount)
        {
            PaymentError = "Enter the amount to record.";
            return;
        }

        try
        {
            Banking.PaySars(amount);
            Navigation.NavigateTo("/tax");
        }
        catch (InvalidOperationException exception)
        {
            PaymentError = exception.Message;
        }
    }
}
