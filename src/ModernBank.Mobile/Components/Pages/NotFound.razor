@page "/not-found"
@layout MainLayout

<PageTitle>Page not found · Modern Bank</PageTitle>

<section class="mx-auto grid min-h-dvh max-w-xl content-center justify-items-start px-5 py-12 sm:px-8" aria-labelledby="not-found-heading">
    <span class="grid size-12 place-items-center rounded-2xl bg-wash text-brand"><AppIcon Name="search" Class="size-6" /></span>
    <h1 id="not-found-heading" class="mt-5 font-display text-2xl font-semibold tracking-tight">That page isn’t here</h1>
    <p class="mt-2 leading-6 text-secondary">The address may have changed. Return to your dashboard to continue.</p>
    <a class="primary-button mt-5" href="/dashboard">Go to dashboard</a>
</section>
